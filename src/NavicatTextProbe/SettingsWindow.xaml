<Window x:Class="NavicatTextProbe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant 设置"
        Width="820" Height="720" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="AI 与提示词">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="DeepSeek API" />
                        <TextBlock x:Name="ApiKeyStatusText" Margin="0,6,0,12" Foreground="#667788" />

                        <TextBlock FontWeight="SemiBold" Text="新 API Key" />
                        <PasswordBox x:Name="ApiKeyPasswordBox" Margin="0,5,0,5" Height="32" Padding="8,4" />
                        <TextBlock Foreground="#7B241C" TextWrapping="Wrap"
                                   Text="留空表示保留现有 Key。Key 只保存到 Windows 凭据管理器，不写入项目文件或日志。" />
                        <CheckBox x:Name="ClearApiKeyCheckBox" Margin="0,9,0,16" Content="删除已保存的 API Key" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="API 地址" />
                                <TextBox x:Name="ApiBaseUrlTextBox" Margin="0,5,0,0" Height="31" Padding="7,3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="模型" />
                                <TextBox x:Name="ModelTextBox" Margin="0,5,0,0" Height="31" Padding="7,3" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AiEnabledCheckBox" Margin="0,0,0,14" FontWeight="SemiBold"
                                  Content="启用自动 AI 预测" />

                        <TextBlock FontWeight="SemiBold" Text="全局补充提示词" />
                        <TextBlock Margin="0,4,0,5" Foreground="#667788" TextWrapping="Wrap"
                                   Text="内置系统提示词已经负责 SQL Copilot、新手补全和错误诊断；这里填写你的业务、命名和输出偏好。" />
                        <TextBox x:Name="GlobalPromptTextBox" MinHeight="220" Padding="9"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="输入停止后等待" />
                            <TextBox x:Name="DebounceTextBox" Width="80" Height="29" Margin="10,0,7,0" Padding="6,2" />
                            <TextBlock VerticalAlignment="Center" Text="毫秒（新起一行会更快触发）" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="普通请求最短间隔" />
                            <TextBox x:Name="MinimumIntervalTextBox" Width="80" Height="29" Margin="10,0,7,0" Padding="6,2" />
                            <TextBlock VerticalAlignment="Center" Text="毫秒（避免慢速打字时连续请求）" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="展示与样式">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="AssistantEnabledCheckBox" FontSize="15" FontWeight="SemiBold"
                                  Content="启用 Assistant" />
                        <TextBlock Margin="22,5,0,18" Foreground="#667788" TextWrapping="Wrap"
                                   Text="关闭时会停止探测、AI 请求、键盘兜底、任务栏提示和手机服务；Ctrl+Alt+S 可随时整体开启或关闭。" />

                        <Separator />
                        <CheckBox x:Name="TaskbarEnabledCheckBox" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold"
                                  Content="启用任务栏内双行建议" />
                        <TextBlock Margin="22,5,0,0" Foreground="#667788" TextWrapping="Wrap"
                                   Text="显示在 Windows 11 任务栏内、通知区域左侧的空白位置；无边框、最多两行，不参与 Alt+Tab，也不修改或注入 Explorer。" />
                        <Grid Margin="22,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="字号" />
                            <TextBox x:Name="TaskbarFontSizeTextBox" Grid.Column="1" Padding="6,2" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="背景透明度" />
                            <TextBox x:Name="TaskbarOpacityTextBox" Grid.Column="3" Padding="6,2" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="行高" />
                            <TextBox x:Name="TaskbarLineHeightTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="背景色" />
                                <TextBox x:Name="TaskbarBackgroundTextBox" Width="82" Margin="8,0,12,0" Padding="6,2" />
                                <TextBlock VerticalAlignment="Center" Text="字体色" />
                                <TextBox x:Name="TaskbarForegroundTextBox" Width="82" Margin="8,0,0,0" Padding="6,2" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="期望宽度（像素）" />
                            <TextBox x:Name="TaskbarWidthTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0" VerticalAlignment="Center"
                                       Foreground="#667788" Text="200–1400；空白位置不足时自动缩窄" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="手机、监听与快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="MobileEnabledCheckBox" FontSize="15" FontWeight="SemiBold"
                                  Content="启用局域网手机页面" />
                        <StackPanel Margin="22,10,0,18" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="端口" />
                            <TextBox x:Name="MobilePortTextBox" Width="100" Height="29" Margin="10,0" Padding="6,2" />
                            <TextBlock VerticalAlignment="Center" Text="访问令牌" />
                            <TextBox x:Name="MobileTokenTextBox" Width="180" Height="29" Margin="10,0" Padding="6,2" />
                        </StackPanel>
                        <TextBlock Margin="22,0,0,5" FontWeight="SemiBold" Text="手机页面建议样式" />
                        <Grid Margin="22,0,0,18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="字号"/><TextBox x:Name="MobileFontSizeTextBox" Grid.Column="1" Padding="6,2"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="行高"/><TextBox x:Name="MobileLineHeightTextBox" Grid.Column="3" Padding="6,2"/>
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="背景/字体色"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBox x:Name="MobileBackgroundTextBox" Width="82" Padding="6,2"/><TextBox x:Name="MobileForegroundTextBox" Width="82" Margin="8,0" Padding="6,2"/>
                                <TextBlock VerticalAlignment="Center" Text="透明度"/><TextBox x:Name="MobileOpacityTextBox" Width="70" Margin="8,0,0,0" Padding="6,2"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="KeyboardFallbackCheckBox" Margin="0,0,0,5" FontSize="15" FontWeight="SemiBold"
                                  Content="允许键盘监听兜底" />
                        <TextBlock Margin="22,0,0,20" Foreground="#7B241C" TextWrapping="Wrap"
                                   Text="默认关闭。只有 Navicat 位于前台且全文读取失败时才记录临时按键缓冲，不写原始按键日志；IME 和粘贴内容无法仅靠键盘钩子完整恢复。" />

                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="全局快捷键" />
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="整体显示/隐藏并启停" />
                            <TextBox x:Name="AssistantHotkeyTextBox" Grid.Column="1" Padding="6,2" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="分析 Navicat 选中 SQL" />
                            <TextBox x:Name="AnalyzeHotkeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="生成/切换 3 个续写候选" />
                            <TextBox x:Name="CandidateHotkeyTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Padding="6,2" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="96" Height="34" Margin="0,0,10,0" IsCancel="True" Content="取消" />
            <Button Width="110" Height="34" IsDefault="True" Click="SaveButton_OnClick" Content="保存设置" />
        </StackPanel>
    </Grid>
</Window>
