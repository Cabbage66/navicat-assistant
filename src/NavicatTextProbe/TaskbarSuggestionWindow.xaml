<Window x:Class="NavicatTextProbe.TaskbarSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏内 SQL 建议"
        Width="340" Height="44" MinWidth="200" MinHeight="30"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" Background="Transparent" AllowsTransparency="True">
    <Border x:Name="SuggestionBorder" Margin="1" Padding="8,3" CornerRadius="4"
            ClipToBounds="True" BorderBrush="#46515C" BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开设置" Click="OpenSettingsMenuItem_OnClick" />
                <MenuItem Header="隐藏任务栏内建议" Click="HideMenuItem_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <TextBlock x:Name="SuggestionText" FontFamily="Cascadia Mono, Consolas"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Foreground="White"
                   Text="等待 SQL 建议……" />
    </Border>
</Window>
